# Secrets — real API keys, webhooks, tokens live in credentials.py.
# NEVER commit it. Template: credentials.example.py (config.py itself
# holds only strategy knobs now and IS tracked).
credentials.py

# Live trading data — real-money positions, not for version control.
*.db
*.db-wal
*.db-shm

# Logs
*.log

# Python
__pycache__/
*.pyc

# Data cache (regenerable via fetch_oe.py / refresh_data.py, 297MB+)
data/

# Server mirror (pull_server_state.py): the LIVE money DB + the server's
# generated ratings. Real trading history — never version-controlled. The *.db
# rule above already covers the databases; this covers the .json files too.
server_mirror/

# XGBoost artifacts: only the approved LoL activation model is tracked.
xgb_models/*
!xgb_models/lol.meta.json
!xgb_models/lol.ubj
